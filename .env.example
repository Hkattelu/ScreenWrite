# ScreenWrite environment configuration.
# Copy to .env (the onboarding wizard does this for you) and fill in your keys.

# Pexels API key — enables high-quality stock B-roll.
# Get one at https://www.pexels.com/api/
PEXELS_API_KEY=your_api_key_here

# Gemini API key — enables LLM-generated visual B-roll search queries.
# When unset, ScreenWrite falls back to heuristic query generation.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: override the Gemini model used for query generation.
# GEMINI_MODEL=gemini-2.0-flash
